<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0F1E"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Logo / Brand -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ghora Pay"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SMS Payment Capture Service"
            android:textSize="14sp"
            android:textColor="#64748B"
            android:layout_marginBottom="32dp" />

        <!-- SMS Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <View
                android:id="@+id/statusSms"
                android:layout_width="4dp"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMS Permission"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvSmsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Checking..."
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Service Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:layout_marginBottom="24dp">

            <View
                android:id="@+id/statusService"
                android:layout_width="4dp"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gateway Status"
                android:textSize="12sp"
                android:textColor="#64748B"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Initializing..."
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Grant Permissions Button -->
        <Button
            android:id="@+id/btnGrant"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Grant Required Permissions"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#6366F1"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <!-- Battery Optimization Button -->
        <Button
            android:id="@+id/btnIgnoreBattery"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Disable Battery Optimization"
            android:textColor="#000000"
            android:textStyle="bold"
            android:backgroundTint="#F59E0B"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Once permissions are granted, you can minimize this app.\nThe service runs in the background automatically."
            android:textSize="12sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

    </LinearLayout>
</ScrollView>
